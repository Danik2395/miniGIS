{
    "version": 3,
    "configurePresets": [
        {
            "name": "debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "environment": {
                "CC": "clang",
                "CXX": "clang++"
            },
            "cacheVariables":
            {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "ENABLE_SANITIZERS": "OFF",
                "ENABLE_COVERAGE": "ON",
                "gtest_force_shared_crt": {
                    "type": "BOOL",
                    "value": "ON"
                }
            }
        },
        {
            "name": "debug-san",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "ENABLE_SANITIZERS": "ON",
                "ENABLE_COVERAGE": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "debug-san",
            "configurePreset": "debug-san"
        }
    ]
}

